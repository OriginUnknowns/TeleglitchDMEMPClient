<Window x:Class="GlitchMod.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="GlitchMod" Width="1160" Height="720" MinWidth="980" MinHeight="620"
        WindowStartupLocation="CenterScreen" WindowStyle="None"
        Background="{StaticResource Ink}" Foreground="{StaticResource Paper}"
        ResizeMode="CanResize">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" CornerRadius="0"/>
    </shell:WindowChrome.WindowChrome>

    <Border BorderBrush="{StaticResource Line}" BorderThickness="1" Background="{StaticResource Ink}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="30"/>
            </Grid.RowDefinitions>

            <!-- title bar -->
            <Border Grid.Row="0" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1"
                    Background="#0D1112" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                        <Border Width="25" Height="25" BorderBrush="{StaticResource Acid}" BorderThickness="1.5">
                            <Grid>
                                <Rectangle Width="7" Height="7" Fill="{StaticResource Acid}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="4"/>
                                <Rectangle Width="7" Height="7" Fill="{StaticResource Acid}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="4"/>
                            </Grid>
                        </Border>
                        <TextBlock Text="GLITCHMOD" FontFamily="Consolas" FontWeight="Bold" FontSize="15"
                                   VerticalAlignment="Center" Margin="10,0,0,0" Foreground="{StaticResource Paper}"/>
                        <Border Background="#293018" Margin="9,0,0,0" Padding="6,2" CornerRadius="2" VerticalAlignment="Center">
                            <TextBlock Text="ALPHA" FontFamily="Consolas" FontSize="9" FontWeight="Bold" Foreground="{StaticResource Acid}"/>
                        </Border>
                    </StackPanel>
                    <Button x:Name="UpdateButton" Grid.Column="1" Content="CHECK UPDATES"
                            Style="{StaticResource FlatButton}" Foreground="{StaticResource Acid}"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            Margin="0,0,10,0" Padding="11,5"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="Update_Click"/>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Content="—" Width="44" Height="47" Style="{StaticResource FlatButton}"
                                BorderThickness="0" Background="Transparent" Click="Minimize_Click"/>
                        <Button Content="□" Width="44" Height="47" Style="{StaticResource FlatButton}"
                                BorderThickness="0" Background="Transparent" Click="Maximize_Click"/>
                        <Button Content="×" Width="44" Height="47" Style="{StaticResource FlatButton}"
                                BorderThickness="0" Background="Transparent" Click="Close_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- main body -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="238"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="316"/>
                </Grid.ColumnDefinitions>

                <!-- instances -->
                <Border Grid.Column="0" Background="#0D1112" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
                    <Grid Margin="14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Text="INSTANCES" Style="{StaticResource LabelCaps}" Margin="4,4,0,10"/>
                            <StackPanel x:Name="ProfilesPanel"/>
                        </StackPanel>
                        <StackPanel Grid.Row="2">
                            <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Margin="0,0,0,12"/>
                            <Button Content="+  IMPORT MOD ZIP" Style="{StaticResource FlatButton}" Margin="0,0,0,8"
                                    HorizontalContentAlignment="Left" Click="ImportMod_Click"/>
                            <Button Content="OPEN GAME FOLDER" Style="{StaticResource FlatButton}"
                                    HorizontalContentAlignment="Left" Click="OpenGameFolder_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- selected instance -->
                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="32,28,32,30">
                        <TextBlock Text="SELECTED INSTANCE" Style="{StaticResource LabelCaps}"/>
                        <TextBlock x:Name="ProfileTitle" Text="MULTIPLAYER ALPHA" FontFamily="Segoe UI Semibold"
                                   FontWeight="Bold" FontSize="33" Margin="0,5,0,0"/>
                        <TextBlock x:Name="ProfileSubtitle"
                                   Text="Co-op campaign through the OriginUnknowns relay."
                                   Foreground="{StaticResource Muted}" FontSize="14" Margin="1,4,0,24"/>

                        <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}"
                                BorderThickness="1" CornerRadius="4" Padding="18">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="GAME INSTALLATION" Style="{StaticResource LabelCaps}"/>
                                    <TextBlock x:Name="GamePathText" Text="Looking for Teleglitch…"
                                               TextTrimming="CharacterEllipsis" FontFamily="Consolas" FontSize="12"
                                               Margin="0,8,16,0"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,9,0,0">
                                        <Ellipse x:Name="GameStatusDot" Width="7" Height="7" Fill="{StaticResource Muted}" Margin="0,0,7,0"/>
                                        <TextBlock x:Name="GameStatusText" Text="NOT CHECKED" Style="{StaticResource LabelCaps}"/>
                                    </StackPanel>
                                </StackPanel>
                                <Button Grid.Column="1" Content="CHANGE" Style="{StaticResource FlatButton}"
                                        VerticalAlignment="Center" Click="BrowseGame_Click"/>
                            </Grid>
                        </Border>

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}"
                                    BorderThickness="1" CornerRadius="4" Padding="17">
                                <StackPanel>
                                    <TextBlock Text="LOADER" Style="{StaticResource LabelCaps}"/>
                                    <TextBlock x:Name="LoaderStateText" Text="Not installed" FontSize="17"
                                               FontFamily="Segoe UI Semibold" Margin="0,5,0,2"/>
                                    <TextBlock x:Name="LoaderVersionText" Text="Payload unavailable"
                                               Foreground="{StaticResource Muted}" FontSize="12"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}"
                                    BorderThickness="1" CornerRadius="4" Padding="17">
                                <StackPanel>
                                    <TextBlock Text="RELAY" Style="{StaticResource LabelCaps}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,1">
                                        <Ellipse x:Name="RelayStatusDot" Width="8" Height="8" Fill="{StaticResource Muted}" Margin="0,0,8,0"/>
                                        <TextBlock x:Name="RelayStateText" Text="Checking…" FontSize="17"
                                                   FontFamily="Segoe UI Semibold"/>
                                    </StackPanel>
                                    <TextBlock x:Name="RelayAddressText" Text="No endpoint configured"
                                               Foreground="{StaticResource Muted}" FontFamily="Consolas" FontSize="12"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}"
                                BorderThickness="1" CornerRadius="4" Padding="18" Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Text="QUICK NOTES" Style="{StaticResource LabelCaps}" Margin="0,0,0,9"/>
                                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="13"
                                           LineHeight="20">
                                    This is an early multiplayer build. Rooms support up to four players.
                                    Everyone must use the same GlitchMod release. The host leaving closes the room.
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                            <Button x:Name="InstallButton" Content="INSTALL / REPAIR" Style="{StaticResource FlatButton}"
                                    Margin="0,0,10,0" Click="InstallRepair_Click"/>
                            <Button x:Name="LaunchButton" Content="▶  LAUNCH" Style="{StaticResource LaunchButton}"
                                    Click="Launch_Click"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- mods -->
                <Border Grid.Column="2" Background="#0D1112" BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0">
                    <Grid Margin="18">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="MODS IN THIS INSTANCE" Style="{StaticResource LabelCaps}" Margin="0,4,0,7"/>
                        <TextBlock Grid.Row="1" x:Name="ModsSummaryText" Text="0 enabled"
                                   Foreground="{StaticResource Muted}" FontSize="13" Margin="0,0,0,13"/>
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="ModsPanel"/>
                        </ScrollViewer>
                        <StackPanel Grid.Row="3" Margin="0,12,0,0">
                            <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Margin="0,0,0,12"/>
                            <Button Content="REMOVE LOADER" Style="{StaticResource FlatButton}"
                                    Foreground="{StaticResource Danger}" Click="RemoveLoader_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- status bar -->
            <Border Grid.Row="2" Background="#080A0B" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
                <Grid Margin="12,0">
                    <TextBlock x:Name="StatusText" Text="READY" Style="{StaticResource LabelCaps}" VerticalAlignment="Center"/>
                    <TextBlock Text="TELEGLITCH: DIE MORE EDITION  •  WINDOWS / STEAM"
                               Style="{StaticResource LabelCaps}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
